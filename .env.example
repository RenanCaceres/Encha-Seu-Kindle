# ==============================================================================
# CONFIGURAÇÕES DO TELEGRAM - ENCHA SEU KINDLE (MTProto Dual Client)
# Obtenha API_ID e API_HASH em: https://my.telegram.org
# Obtenha BOT_TOKEN no @BotFather do Telegram
# ==============================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=seu_telegram_api_hash_aqui
TELEGRAM_BOT_TOKEN=1234567890:AAH_seu_token_do_botfather_aqui

# ==============================================================================
# CONTROLE DE ACESSO E USUÁRIOS AUTORIZADOS (IDs numéricos do Telegram)
# ADMIN_USER_ID: ID do administrador principal (habilita monitor de Mensagens Salvas)
# ALLOWED_USER_IDS: Lista de IDs liberados para usar o bot (separados por vírgula)
# ==============================================================================
ADMIN_USER_ID=1000000000
ADMIN_NAME=Admin
ALLOWED_USER_IDS=1000000000,2000000000,3000000000

# ==============================================================================
# E-MAILS & SERVIDOR SMTP (GMAIL COM SENHA DE APP)
# Importante: Adicione o endereço GMAIL_USER na lista de e-mails aprovados da
# Amazon em: https://www.amazon.com.br/mycd -> Preferências -> Documentos Pessoais
# ==============================================================================
GMAIL_USER=seu_email_remetente@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app_de_16_digitos
KINDLE_EMAIL=seu_email_do_kindle@kindle.com

# ==============================================================================
# FONTES DE ACERVO E PARÂMETROS DE FILA
# SOURCE_CHANNEL: Username ou ID do canal de acervo principal no Telegram
# SECONDARY_SOURCE_BOT: Username do bot de acervo secundário (fallback opcional)
# ==============================================================================
SOURCE_CHANNEL=username_do_canal_de_acervo
SECONDARY_SOURCE_BOT=username_do_bot_de_acervo_secundario
SEND_DELAY_SECONDS=5

# Opcional: Lista de IDs de posts para comando administrativo /reenviar_lote
RESEND_BATCH_POSTS=
